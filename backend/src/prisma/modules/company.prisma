model Company {
  id   Int    @id @default(autoincrement())
  name String @unique

  settings CompanySettings?

  users       User[]
  invitations Invitation[]

  performanceRecords PerformanceRecord[] @relation("CompanyPerformance")
  tvDevices   TvDevice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CompanySettings {
  id        String  @id @default(uuid())
  companyId Int     @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  companyName      String?
  logoUrl          String?
  timeZone         String   @default("UTC")
  officeStartTime  String   @default("09:00")
  officeCloseTime  String   @default("17:00")
  dailyResetTime   String   @default("00:00")
  weeklyResetDay   Int      @default(1)
  workWeekEndDay   Int      @default(5)
  weeklyResetTime  String   @default("00:00")
  monthlyResetDay  Int      @default(1)
  monthlyGoal      Int      @default(2000)
  celebrationSound Boolean  @default(true)
  celebrationStyle String   @default("default")
  celebrationSoundUrl String?
  celebrationSoundStartTime Int @default(0)
  celebrationSoundDuration Int @default(10)
  tvTheme          String   @default("dark")
  tvPassword       String?
  reportRecipients String[]
  isReportGenerationActive Boolean @default(true)
}

model TvDevice {
  id         String   @id @default(uuid())
  companyId  Int
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  
  deviceName String
  deviceId   String
  
  isBlocked  Boolean  @default(false)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@unique([companyId, deviceId])
}
