enum PerformancePeriod {
  DAILY
  WEEKLY
  MONTHLY
}

enum AuditAction {
  ADDED
  UPDATED
}

model PerformanceRecord {
  id         Int               @id @default(autoincrement())
  period     PerformancePeriod
  startDate  DateTime
  salesCount Int               @default(0)

  agentId Int?
  agent   User? @relation("AgentPerformance", fields: [agentId], references: [id], onDelete: Cascade)

  companyId Int
  company   Company @relation("CompanyPerformance", fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, period, startDate])
}

model SalesAuditLog {
  id             Int         @id @default(autoincrement())
  action         AuditAction
  previousAmount Int
  newAmount      Int
  date           DateTime

  agentId Int
  agent   User @relation("AgentAudit", fields: [agentId], references: [id], onDelete: Cascade)

  managerId Int
  manager   User @relation("ManagerAudit", fields: [managerId], references: [id], onDelete: Cascade)

  saleId Int?
  sale   Sale? @relation(fields: [saleId], references: [id])

  isReversed Boolean @default(false)

  createdAt DateTime @default(now())
}

enum AgentAction {
  AGENT_ADDED
  AGENT_UPDATED
  AGENT_DEACTIVATED
  AGENT_ACTIVATED
}

model AgentActivityLog {
  id      Int         @id @default(autoincrement())
  action  AgentAction
  details String? // Optional JSON string for what changed
  date    DateTime    @default(now())

  agentId Int
  agent   User @relation("AgentActivityTarget", fields: [agentId], references: [id], onDelete: Cascade)

  managerId Int
  manager   User @relation("ManagerActivityPerformer", fields: [managerId], references: [id], onDelete: Cascade)
}
