model Sale {
  id     Int        @id @default(autoincrement())
  amount Int        @default(1)
  status SaleStatus @default(CONFIRMED)

  agentId Int
  agent   User @relation("AgentSales", fields: [agentId], references: [id], onDelete: Cascade)

  managerId Int
  manager   User @relation("ManagerSales", fields: [managerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  auditLogs SalesAuditLog[]
}
